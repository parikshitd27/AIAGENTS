# Copy this file to .env and edit.

# --- Local model via Ollama (default, no API key needed) ---
LLM_PROVIDER=ollama
# Must match a name shown by:  ollama list
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_HOST=http://localhost:11434
# Context window in tokens. Raise (e.g. 16384) if you have RAM/VRAM to spare.
OLLAMA_NUM_CTX=8192
# Max transcript characters sent to each agent (~4 chars per token).
# If you raise OLLAMA_NUM_CTX, raise this too (16384 ctx -> ~30000 chars).
MAX_TRANSCRIPT_CHARS=12000

# --- Optional: OpenAI instead ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
